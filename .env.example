# === Realtime (Ably) ===========================================================
# 本番でスマホ間を同期するために必須。https://ably.com でアプリを作りキーを取得。
# サーバ側だけで使用（クライアントには露出しない。/api/ably/token 経由でトークン発行）
ABLY_API_KEY=

# Ably を使う場合は "1" にする。未設定/0 のときは同一ブラウザ内タブだけで動く
# デモモード（BroadcastChannel）になり、Ablyキー無しでも挙動を確認できる。
NEXT_PUBLIC_ABLY_ENABLED=

# === ショー情報（観客画面のフォローゲート/タイトルに使用） =====================
NEXT_PUBLIC_SHOW_ID=band-live
NEXT_PUBLIC_SHOW_TITLE=LIVE ENHANCE LIGHTS
# バンドのInstagramプロフィールURL（自己申告フォローゲートのリンク先）
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/

# === マスターコンソールの簡易パスコード ========================================
# 注: クライアント側の簡易ゲートです。URLとコードを関係者だけで共有してください。
NEXT_PUBLIC_MASTER_PASSCODE=0000
