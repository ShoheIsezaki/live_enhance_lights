# === Realtime (Ably) ===========================================================
# 本番でスマホ間を同期するために必須。https://ably.com のアプリの Root キー。
# サーバ側だけで使用（クライアントには露出しない。/api/ably/token 経由でトークン発行）
#
# ⚠️ 実際のキーはここ（＝リポジトリ）に書かず、Vercel の環境変数に設定すること。
#    キーをコミットすると Git 履歴に残り漏洩の原因になります。
ABLY_API_KEY=

# Ably を使う場合は "1" にする。未設定/0 のときは同一ブラウザ内タブだけで動く
# デモモード（BroadcastChannel）になり、Ablyキー無しでも挙動を確認できる。
NEXT_PUBLIC_ABLY_ENABLED=

# === ショー情報 =================================================================
# 未設定でも src/lib/config.ts の既定値（このバンド用）が使われる。上書きしたい時だけ設定。
NEXT_PUBLIC_SHOW_ID=the-rox-quattro-live
NEXT_PUBLIC_SHOW_TITLE=最高は今 TWO-MAN LIVE
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/theroxgwo/

# === マスターコンソールの簡易パスコード ========================================
# 注: クライアント側の簡易ゲートです。URLとコードを関係者だけで共有してください。
NEXT_PUBLIC_MASTER_PASSCODE=5150
